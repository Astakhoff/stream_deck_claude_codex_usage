{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.local.claude-desktop-week",
  "Name": "Claude & Codex Weekly Usage",
  "Version": "1.8.0.0",
  "Author": "Astakhoff",
  "Description": "Claude and Codex weekly remaining capacity and saved resets using local logins.",
  "Category": "Claude & Codex Weekly Usage",
  "CategoryIcon": "imgs/ai-weekly-category",
  "Icon": "imgs/ai-weekly-plugin",
  "CodePath": "bin/plugin.js",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Software": {
    "MinimumVersion": "6.6"
  },
  "SDKVersion": 2,
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "Name": "Claude weekly remaining",
      "UUID": "com.local.claude-desktop-week.weekly",
      "Icon": "imgs/weekly-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Weekly capacity with Remaining or Used percentage and matching progress bar.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Claude saved resets",
      "UUID": "com.local.claude-desktop-week.resets",
      "Icon": "imgs/reset-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Saved Claude resets and earliest expiry. Read only; refreshes every minute.",
      "PropertyInspectorPath": "ui/resets.html",
      "States": [
        {
          "Image": "imgs/resets-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Codex weekly remaining",
      "UUID": "com.local.claude-desktop-week.codex-weekly",
      "Icon": "imgs/weekly-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Weekly capacity with Remaining or Used percentage and matching progress bar.",
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Codex saved resets",
      "UUID": "com.local.claude-desktop-week.codex-resets",
      "Icon": "imgs/reset-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Read-only Codex resets monitor using the local Codex login.",
      "PropertyInspectorPath": "ui/resets.html",
      "States": [
        {
          "Image": "imgs/resets-key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Claude weekly countdown",
      "UUID": "com.local.claude-desktop-week.claude-countdown",
      "Icon": "imgs/weekly-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Days and hours until the next Claude weekly budget reset.",
      "PropertyInspectorPath": "ui/countdown.html",
      "States": [
        {
          "Image": "imgs/claude-countdown",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Codex weekly countdown",
      "UUID": "com.local.claude-desktop-week.codex-countdown",
      "Icon": "imgs/weekly-action",
      "Controllers": ["Keypad"],
      "Tooltip": "Days and hours until the next Codex weekly budget reset.",
      "PropertyInspectorPath": "ui/countdown.html",
      "States": [
        {
          "Image": "imgs/codex-countdown",
          "ShowTitle": false
        }
      ]
    }
  ],
  "URL": "https://github.com/Astakhoff/stream_deck_claude_codex_usage"
}
